# Configuration pour le déploiement sur Serveur VPS (Caisse MYK)
# Copier ce fichier en `.env` à la racine avant de lancer `docker compose -f docker-compose.prod.yml up -d`

# Port Web exposé sur le VPS (ex: 80 pour HTTP direct, ou 8080 si vous avez un reverse proxy Nginx/Traefik)
WEB_PORT=80

# Mots de passe Base de données PostgreSQL (à changer par des chaînes fortes)
POSTGRES_SUPERPASSWORD=super_secret_postgres_password_a_remplacer
CAISSE_DB_PASSWORD=secret_caisse_db_password_a_remplacer
HOTEL_DB_PASSWORD=secret_hotel_db_password_a_remplacer

# Clé secrète JWT pour l'authentification (doit comporter au moins 64 caractères aléatoires)
JWT_SECRET=generer_une_chaine_aleatoire_tres_longue_et_securisee_d_au_moins_64_caracteres_ici

# Environnement
APP_ENV=production
DEBUG=false

# Domaines ou IP autorisés (séparés par des virgules ou * pour tout autoriser)
ALLOWED_HOSTS=*
CORS_ORIGINS=*

# Fuseau horaire
TZ=Africa/Abidjan

# Facturation Normalisée (FNE)
# Valeurs possibles : manual (saisie manuelle des stickers), api (DGI direct), mock (tests)
FNE_PROVIDER=manual
FNE_API_BASE_URL=http://54.247.95.108/ws
FNE_API_KEY=
