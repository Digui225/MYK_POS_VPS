# Copié dans /opt/Departement_Bi/OsisPos_Backend/api.env (chmod 600, root). Variables lues :
# apps/api/src/caisse/core/config.py (une variable au nom inconnu est ignorée sans message).
APP_ENV=production
# Obligatoirement false en production (l'API refuse de démarrer sinon)
DEBUG=false
# Swagger (/docs) : true seulement le temps d'un besoin du dev front
ENABLE_DOCS=false

# même mot de passe que POSTGRES_PASSWORD de db.env
DATABASE_URL=postgresql+psycopg://caisse:<mot-de-passe>@caisse-db:5432/caisse
# openssl rand -base64 48 | tr -d '\n/+='
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_HOURS=12
# 5 PIN erronés consécutifs depuis un poste : ses connexions bloquées 5 min
PIN_MAX_FAILED_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=5

# Front servi par le même nom que l'API : CORS inutile pour lui. localhost:5173 = Vite du dev front.
CORS_ORIGINS=https://caisse.osispos.com,http://localhost:5173
# En-tête Host accepté. L'IP reste le temps que l'agent d'impression passe sur le domaine ;
# localhost : contrôle de santé du conteneur et de update.sh.
ALLOWED_HOSTS=caisse.osispos.com,148.113.149.10,localhost,127.0.0.1
MAX_REQUEST_BODY_SIZE=2097152

# WebSocket sans ?token= : refusé si true. Passer à true quand le front envoie le jeton.
WS_REQUIRE_AUTH=false

# FNE simulée : aucun appel à la DGI ; les tickets portent « SIMULATION FNE - SANS VALEUR FISCALE ».
# (manual : rien n'est envoyé, chaque FNE attend une saisie manuelle.)
FNE_PROVIDER=mock
# Production, le jour de la bascule (README §4) : vider d'abord les FNE de test, puis
#   FNE_PROVIDER=api
#   FNE_API_BASE_URL=https://www.services.fne.dgi.gouv.ci/ws
#   FNE_API_KEY=<clé de production : ici seulement, jamais dans le dépôt ni dans un message>
#   FNE_POINT_OF_SALE=<nom exact du point de vente de la caisse dans l'espace FNE>
#   FNE_ESTABLISHMENT=RESTAURANT CHEZ SYLLA PLUS
# Test DGI : FNE_API_BASE_URL=http://54.247.95.108/ws avec la clé de TEST.

TZ=Africa/Abidjan
