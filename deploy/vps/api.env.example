# Copié dans /opt/caisse/api.env (chmod 600). Variables : src/caisse/config.py
APP_ENV=production
# Swagger (/docs) gardé ouvert pour le dev front en recette ; à retirer en production réelle
ENABLE_DOCS=true

# même mot de passe que POSTGRES_PASSWORD de db.env
DATABASE_URL=postgresql+psycopg://caisse:<mot-de-passe>@caisse-db:5432/caisse
# openssl rand -base64 48 | tr -d '\n'
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_HOURS=12
PIN_MAX_ATTEMPTS=5
PIN_LOCK_SECONDS=30

# Front déployé + front en dev local (Vite) qui appellerait le VPS ; « * » ignoré en production
CORS_ORIGINS=http://148.113.149.10:8083,http://localhost:5173
# En-tête Host accepté (localhost : healthcheck du conteneur)
ALLOWED_HOSTS=148.113.149.10,localhost,127.0.0.1
MAX_REQUEST_BODY_BYTES=2097152
LOGIN_RATE_LIMIT_PER_MINUTE=10
REFRESH_RATE_LIMIT_PER_MINUTE=30

# L'agent du terminal vient chercher les tickets (jeton : POST /api/v1/printing/terminals)
PRINT_AGENT_OFFLINE_AFTER_SECONDS=15
PRINT_JOB_STALE_SECONDS=120
# Caractères par ligne des tickets : 32 = 58 mm (Xprinter du restaurant) · 48 = 80 mm
PRINTER_WIDTH=32

# FNE simulée : aucun appel à la DGI, aucun sticker consommé.
# Recette : mock ou environnement de test DGI (http://54.247.95.108/ws + clé de test).
# JAMAIS la clé de production ici : chaque FNE de test deviendrait une vraie facture.
FNE_PROVIDER=mock

TZ=Africa/Abidjan
