# Identifiants USB : `lsusb` → « ID 0416:5011 » → 0x0416 / 0x5011
PRINTER_VENDOR_ID=0x0416
PRINTER_PRODUCT_ID=0x5011
# Points de terminaison USB (valeurs par défaut de la plupart des imprimantes ESC/POS)
PRINTER_IN_EP=0x82
PRINTER_OUT_EP=0x01
# 48 caractères = 80 mm · 32 = 58 mm (Xprinter du restaurant)
PRINTER_WIDTH=32
PRINTER_CODEPAGE=CP858
# Impulsion tiroir, en hexadécimal : ESC p 0 25 250 (certains modèles : ESC p 1 → 1b700119fa)
DRAWER_PULSE=1b700019fa
# usb = imprimante réelle (Linux) · dummy = aucune imprimante (développement), le ticket va dans
# le journal · win32 : poste Windows, voir windows/.env.example
PRINTER_BACKEND=usb

# Caisse en ligne, sans /api/v1 (développement : http://localhost:8001)
API_URL=https://gestion.example.ci
# Jeton du terminal : POST /api/v1/printing/terminals (ADMIN) ou
# `python -m caisse.cli create-print-terminal --name Comptoir` ; affiché une seule fois
TERMINAL_TOKEN=
POLL_INTERVAL_SECONDS=2
REQUEST_TIMEOUT_SECONDS=10
