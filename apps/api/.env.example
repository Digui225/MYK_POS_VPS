# Environnement
APP_NAME="OsisPos API"
APP_ENV="development"
DEBUG=true
PORT=8001
HOST="0.0.0.0"

# Base de données
DATABASE_URL="postgresql+psycopg://caisse:caisse_secret@localhost:5432/caisse"

# Sécurité & Auth
JWT_SECRET="changeme_in_production_super_secret_key_minimum_64_characters_long_123456"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_HOURS=12

# Fuseau horaire
TZ="Africa/Abidjan"

# Intégrations
PRINT_AGENT_URL="http://host.docker.internal:8090"
BACKUP_DIR="/var/backups/caisse"

# Facturation Normalisée (FNE - DGI Côte d'Ivoire)
# Mode : manual | api | mock
FNE_PROVIDER="api"
FNE_API_BASE_URL="https://www.services.fne.dgi.gouv.ci/ws"
FNE_API_KEY=""
FNE_POINT_OF_SALE="point de vente 1"
FNE_ESTABLISHMENT="RESTAURANT CHEZ SYLLA PLUS"
FNE_SYNC_TIMEOUT_SECONDS=4.0
