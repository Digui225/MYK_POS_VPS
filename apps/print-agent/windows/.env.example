# Agent d'impression — poste Windows (Xprinter 58 mm, pilote du fabricant installé)
# Copié en ..\.env par install.ps1 ; à éditer avec : notepad .env

# Caisse en ligne, sans /api/v1
API_URL=https://caisse.osispos.com
# Jeton du terminal, affiché une seule fois à sa création :
#   python -m caisse.cli create-print-terminal --name Comptoir   (sur le serveur)
TERMINAL_TOKEN=

PRINTER_BACKEND=win32
# Nom exact de l'imprimante dans Windows : .venv\Scripts\python.exe -m agent --list
PRINTER_NAME=XP-58
# 58 mm = 32 caractères (la même valeur que PRINTER_WIDTH de l'API)
PRINTER_WIDTH=32
# Si les accents du ticket de test sortent faux : essayer CP850
PRINTER_CODEPAGE=CP858
# Impulsion tiroir : ESC p 0 25 250 (certains modèles : ESC p 1 → 1b700119fa)
DRAWER_PULSE=1b700019fa
# Délai pour que Windows transmette le ticket ; au-delà, il est retiré de la file Windows
SPOOL_TIMEOUT_SECONDS=15

POLL_INTERVAL_SECONDS=2
REQUEST_TIMEOUT_SECONDS=10
LOG_FILE=logs/agent.log
